# ===== Backend selection =====
# Embedder:  openai | local | hashing
# LLM:       openai | ollama | mock
# DOCUQA_EMBEDDER=openai
# DOCUQA_LLM=openai

# OpenAI-compatible API key (required when DOCUQA_EMBEDDER/LLM is "openai").
OPENAI_API_KEY=sk-your-key-here

# Optional: point to any OpenAI-compatible endpoint (proxy, gateway, local server).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the default OpenAI models.
# DOCUQA_MODEL=gpt-4o-mini
# DOCUQA_EMBEDDING_MODEL=text-embedding-3-small

# ===== Local (privacy-preserving) backends =====
# Fully local embeddings via fastembed (pip install -e ".[local]").
# DOCUQA_EMBEDDER=local
# DOCUQA_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# For Chinese documents, use: BAAI/bge-small-zh-v1.5

# Local LLM via Ollama (https://ollama.com).
# DOCUQA_LLM=ollama
# DOCUQA_OLLAMA_MODEL=llama3.2
# DOCUQA_OLLAMA_BASE_URL=http://localhost:11434

# Optional: tuning.
# DOCUQA_INDEX_DIR=.docuqa
# DOCUQA_CHUNK_SIZE=500
# DOCUQA_CHUNK_OVERLAP=50
# DOCUQA_TOP_K=4
