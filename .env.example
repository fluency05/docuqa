# OpenAI-compatible API key (required unless you use the --offline demo mode).
OPENAI_API_KEY=sk-your-key-here

# Optional: point to any OpenAI-compatible endpoint (proxy, gateway, local server).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the default models.
# DOCUQA_MODEL=gpt-4o-mini
# DOCUQA_EMBEDDING_MODEL=text-embedding-3-small

# Optional: tuning.
# DOCUQA_INDEX_DIR=.docuqa
# DOCUQA_CHUNK_SIZE=500
# DOCUQA_CHUNK_OVERLAP=50
# DOCUQA_TOP_K=4
